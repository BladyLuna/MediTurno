@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam maxMessageSize 180
title Diagrama de Secuencia — Gestión de Usuarios

actor Administrador as admin
participant "Navegador\n(Blade + Bootstrap)" as web
participant "UserController" as ctrl
participant "UserPolicy\n(Gates)" as policy
participant "AuditLogService" as audit
database "Base de Datos" as db

== ESCENARIO: Crear usuario (POST /admin/users) ==
admin -> web : Llena formulario (nombre, email, password, rol)
web -> ctrl : POST /admin/users
ctrl -> policy : authorize create
policy --> ctrl : Permitido (admin)
ctrl -> db : User::create (password hasheada)
db --> ctrl : Usuario creado
ctrl -> audit : record('created', usuario, datos)
audit -> db : Inserta en audit_logs
ctrl --> admin : Redirige con mensaje de éxito

== ESCENARIO: Eliminar usuario (DELETE /admin/users/{user}) ==
admin -> web : Solicita eliminar usuario
web -> ctrl : DELETE /admin/users/{user}
ctrl -> policy : authorize delete
policy --> ctrl : Permitido
ctrl -> db : Valida no es sí mismo ni último admin
db --> ctrl : Reglas cumplidas
ctrl -> db : user->delete() (SoftDeletes)
ctrl -> audit : record('deleted', usuario, valores)
audit -> db : Inserta en audit_logs
ctrl --> admin : Redirige con mensaje de éxito

@enduml
