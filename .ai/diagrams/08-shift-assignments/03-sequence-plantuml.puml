@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam sequenceMessageAlign center
skinparam maxMessageSize 200
title Diagrama de Secuencia — Asignación de Turnos (con validación de conflictos)

actor Administrador as admin
participant "Navegador\n(Blade + Bootstrap)" as web
participant "ShiftAssignmentController" as ctrl
participant "AssignmentPolicy\n(Gates)" as policy
participant "ShiftTimeService" as timeSrv
participant "ShiftConflictService" as conflictSrv
participant "AuditLogService" as audit
database "Base de Datos" as db

== ESCENARIO: Crear asignación de turno (POST /admin/shift-assignments) ==
admin -> web : Selecciona personal, servicio, plantilla y fecha
web -> ctrl : POST /admin/shift-assignments
ctrl -> policy : authorize create
policy --> ctrl : Permitido (admin)
ctrl -> db : Carga plantilla de turno (servicio)
db --> ctrl : ServiceShiftTemplate + ShiftTemplate
ctrl -> timeSrv : calculateInterval(fecha, plantilla)
timeSrv -> db : Resuelve horarios efectivos (custom o base)
db --> timeSrv : inicio/fin del turno
timeSrv --> ctrl : start_at, end_at (nocturno cruza día)
ctrl -> conflictSrv : hasConflict(staff, start, end)
conflictSrv -> db : Busca asignaciones traslapadas
db --> conflictSrv : Sin traslapes encontrados
conflictSrv --> ctrl : Sin conflicto (válido)
note over ctrl : Regla BR-006: no se permiten turnos traslapados
ctrl -> db : ShiftAssignment::create (transacción)
ctrl -> audit : record('created', asignación, datos)
audit -> db : Inserta en audit_logs
ctrl --> admin : Redirige "Asignación creada correctamente"

@enduml
